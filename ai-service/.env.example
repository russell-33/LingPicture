# LLM
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.6-flash
QWEN_TOKENIZER_MODEL=Qwen/Qwen3-8B
QWEN_TOKENIZER_LOCAL_ONLY=false

# Embedding
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# Rerank
RERANK_API_KEY=
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3-rerank

# Internal calls between Spring Boot and the Python AI service.
# Use the same value for the Java process environment variable AI_INTERNAL_TOKEN.
AI_INTERNAL_TOKEN=change-me-in-local-env

# Java backend. If ai-service runs in Docker Desktop and backend runs on the host,
# use http://host.docker.internal:8123/api.
JAVA_BACKEND_URL=http://localhost:8123/api

# Redis conversation memory. For local uvicorn, keep localhost.
# For Docker Compose, REDIS_HOST is overridden to the service name "redis".
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=4
